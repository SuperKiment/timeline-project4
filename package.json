{
	"name": "timeline-project4",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
		"user:create": "tsx --env-file-if-exists=.env scripts/user-create.ts",
		"seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
		"backup": "tsx --env-file-if-exists=.env scripts/backup.ts"
	},
	"engines": {
		"node": ">=22.9"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/busboy": "^1.5.4",
		"@types/node": "^22",
		"@types/sanitize-html": "^2.16.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fontsource-variable/newsreader": "^5.3.0",
		"@node-rs/argon2": "^2.2.1",
		"better-sqlite3": "^13.0.3",
		"busboy": "^1.6.0",
		"drizzle-orm": "^0.45.3",
		"file-type": "^22.1.1",
		"heic-convert": "^2.1.0",
		"marked": "^18.0.13",
		"sanitize-html": "^2.17.7",
		"sharp": "^0.35.4",
		"tar": "^7.5.22",
		"tsx": "^4.23.15"
	}
}
