# Server bind address
HOST=0.0.0.0

# Server port
PORT=3000

# Public origin URL, required by SvelteKit CSRF protection when serving
# behind a reverse proxy on a non-default host/port (e.g. https://timeline.example.com)
ORIGIN=

# Directory where the SQLite database, media files and temp uploads live
DATA_DIR=./data

# Timezone used for "today" computations (journal, ce-jour-la, ...)
TZ=Europe/Paris

# Directory where `npm run backup` writes tar.gz archives
BACKUP_DIR=./backups

# Session cookie sliding expiry, in days
SESSION_DAYS=30

# Adapter-node: disable SvelteKit's built-in body size limit so large media
# uploads are rejected by our own code instead (500 MB, see media upload service)
BODY_SIZE_LIMIT=Infinity

# Adapter-node: trust these headers from a reverse proxy (e.g. Caddy) to
# determine the original protocol/host for CSRF origin checks
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
